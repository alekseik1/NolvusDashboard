<UserControl
    x:Class="Nolvus.Dashboard.Frames.Installer.DowngraderFrame"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="32" Background="#2E2E2E">
        <Grid RowDefinitions="Auto,*" RowSpacing="24">

            <!-- HEADER -->
            <TextBlock Text="Stock Game Creation"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <!-- CONTENT -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,350"
                  ColumnSpacing="24">

                <!-- LEFT SIDE PANEL -->
                <Border Grid.Column="0"
                        Background="#363636"
                        BorderBrush="#444"
                        CornerRadius="4"
                        Padding="16">

                    <StackPanel Spacing="20">

                        <!-- SKYRIM DIRECTORY -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Skyrim Directory"
                                       Foreground="White"/>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="TxtSkyrimDir"
                                         Background="#2E2E2E"
                                         Foreground="White"
                                         BorderBrush="#555"/>
                                <Button x:Name="BtnBrowseSkyrimDir"
                                        Grid.Column="1"
                                        Content="Browse"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        MinWidth="90"
                                        Background="#2E2E2E"
                                        BorderBrush="White"
                                        Foreground="White"/>
                            </Grid>
                        </StackPanel>

                        <!-- OUTPUT DIRECTORY -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Output Directory"
                                       Foreground="White"/>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="TxtOutputDir"
                                         Background="#2E2E2E"
                                         Foreground="White"
                                         BorderBrush="#555"/>
                                <Button x:Name="BtnBrowseOutputDir"
                                        Grid.Column="1"
                                        Content="Browse"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        MinWidth="90"
                                        Background="#2E2E2E"
                                        BorderBrush="White"
                                        Foreground="White"/>
                            </Grid>
                        </StackPanel>

                        <!-- START BUTTON -->
                        <Button x:Name="BtnStart"
                                Content="Start"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="#2E2E2E"
                                BorderBrush="#F28F1A"
                                Foreground="#F28F1A"/>

                    </StackPanel>
                </Border>

                <!-- RIGHT SIDE PANEL -->
                <Border Grid.Column="1"
                        Background="#363636"
                        BorderBrush="#444"
                        CornerRadius="4"
                        Padding="16">

                    <Grid RowDefinitions="Auto,*">

                        <!-- TOP INFO TEXT -->
                        <TextBlock Grid.Row="0"
                                   Text="Creates a Stock Game folder by copying and patching your Skyrim installation files. Select your Skyrim directory and an empty output directory, then click Start."
                                   Foreground="#CCCCCC"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <!-- OUTPUT LIST -->
                        <Border Grid.Row="1"
                                BorderThickness="1"
                                BorderBrush="#555"
                                Background="#363636">

                            <ListBox x:Name="LstBxOutput"
                                     Background="#363636"
                                     Foreground="White"
                                     BorderThickness="0"
                                     Margin="4"
                                     SelectionMode="Single">

                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListBox.Styles>

                            </ListBox>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</UserControl>
